{
	"name": "promise-worker-bi",
	"version": "5.0.2",
	"description": "Promise-based messaging for Web Workers and Shared Workers",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"type": "module",
	"scripts": {
		"prepack": "node --run build",
		"build": "rm -rf dist && rollup -c && tsc --emitDeclarationOnly",
		"lint": "node --run build && tsc --noEmit && eslint .",
		"prettier": "prettier --write 'src/*.ts' && prettier --write 'test/*.js' && prettier --write 'scripts/*.js'",
		"test": "node --run build && vitest run",
		"prepare": "husky"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/dumbmatter/promise-worker-bi.git"
	},
	"keywords": [
		"promise",
		"shared worker",
		"sharedworker",
		"web worker",
		"webworker",
		"worker"
	],
	"author": "Jeremy Scheff <jdscheff@gmail.com>",
	"license": "Apache-2.0",
	"bugs": {
		"url": "https://github.com/dumbmatter/promise-worker-bi/issues"
	},
	"homepage": "https://github.com/dumbmatter/promise-worker-bi",
	"devDependencies": {
		"@babel/core": "^7.29.7",
		"@babel/preset-typescript": "^7.29.7",
		"@eslint/js": "^10.0.1",
		"@rollup/plugin-babel": "^7.1.0",
		"@rollup/plugin-node-resolve": "^16.0.3",
		"@typescript-eslint/eslint-plugin": "^8.69.0",
		"@typescript-eslint/parser": "^8.69.0",
		"@vitest/browser-playwright": "^5.0.0",
		"eslint": "^10.10.0",
		"eslint-plugin-import-x": "^4.17.1",
		"globals": "^17.12.0",
		"husky": "^9.1.7",
		"lint-staged": "^17.5.0",
		"oxfmt": "^0.66.0",
		"playwright": "^1.63.0",
		"rollup": "^4.63.1",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.69.0",
		"vitest": "^5.0.0"
	},
	"files": [
		"dist"
	],
	"lint-staged": {
		"*": "oxfmt --no-error-on-unmatched-pattern"
	}
}
